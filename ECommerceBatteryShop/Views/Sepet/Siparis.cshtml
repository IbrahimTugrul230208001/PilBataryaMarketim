@using System.Linq
@{
    ViewBag.Title = "Checkout";
}
@model ECommerceBatteryShop.Models.CheckoutPageViewModel
@{
    decimal subTotal = Model.SubTotal;
    decimal tax = subTotal * 0.2m;
    decimal shipping = Model.ShippingCost;
    if(subTotal >= 2500)
    {
        shipping = 0;
    }
    subTotal = Math.Round(subTotal, 2);
    tax = Math.Round(tax, 2);
    shipping = Math.Round(shipping, 2);
    var defaultAddressId = Model.Addresses.FirstOrDefault(a => a.IsDefault)?.Id
        ?? Model.Addresses.FirstOrDefault()?.Id;
    var contractUrl = defaultAddressId.HasValue
        ? Url.Action("MesafeliSatis", "Sepet", new { addressId = defaultAddressId.Value, shipping })
        : Url.Action("MesafeliSatis", "Sepet", new { shipping });
    contractUrl ??= "/Sepet/MesafeliSatis";
}
@functions {
    public static string NormalizeImg(string? u)
    {
        if (string.IsNullOrWhiteSpace(u)) return "/img/temsili.webp";
        u = u.Replace("\\", "/").Trim();
        if (u.StartsWith("/img/Products/", System.StringComparison.OrdinalIgnoreCase)) return u;
        if (u.StartsWith("img/Products/", System.StringComparison.OrdinalIgnoreCase)) return "/" + u;
        if (u.StartsWith("/img/", System.StringComparison.OrdinalIgnoreCase))
        {
            var fileName = u.Substring(5);
            if (fileName == "temsili.webp" || fileName == "temsili.png" || fileName.Contains("logo") || fileName.Contains("secure"))
            {
                return u;
            }
            return "/img/Products/" + fileName;
        }
        if (u.StartsWith("img/", System.StringComparison.OrdinalIgnoreCase))
        {
            var fileName = u.Substring(4);
            if (fileName == "temsili.webp" || fileName == "temsili.png" || fileName.Contains("logo") || fileName.Contains("secure"))
            {
                return "/" + u;
            }
            return "/img/Products/" + fileName;
        }
        if (u == "temsili.webp" || u == "temsili.png" || u.Contains("placeholder"))
        {
            return "/img/" + u;
        }
        return "/img/Products/" + u.TrimStart('/');
    }
}
<main x-data="checkout(@(subTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)), 0.20)"
      class="bg-white min-h-screen pt-10 pb-24">
    <div class="mx-auto max-w-5xl px-4">
        <!-- Başlık -->
        <header class="mb-8">
            <h1 class="text-2xl font-bold text-slate-900">Ödeme</h1>
            <p class="text-sm text-slate-600 mt-1">Teslimat • Ödeme • Onay</p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Sol sütun -->
            <div class="lg:col-span-2 space-y-8">
                <!-- Adresler -->
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-black/5">
                        <div class="flex flex-wrap items-center justify-between gap-4">
                            <div>
                                <h2 class="text-lg font-semibold text-gray-900">Adresler & Fatura Bilgileri</h2>
                                <p class="text-sm text-gray-500">Teslimat adreslerinizi ve fatura bilgilerinizi yönetin.</p>
                            </div>

                            <button type="button"
                                    x-on:click="$store.address.openNew()"
                                    class="inline-flex items-center gap-2 rounded-full border border-amber-400 px-4 py-2 text-sm font-semibold text-amber-600 hover:border-amber-700 hover:text-amber-700">
                                Yeni adres ekle
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                    <path d="M12 5v14" />
                                    <path d="M5 12h14" />
                                </svg>
                            </button>
                        </div>

                        @await Html.PartialAsync("_AddressListPartial", Model.Addresses)
                    </section>
                }
                else
                {
                    <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-black/5">
                        <div>
                            <h2 class="text-lg font-semibold text-gray-900">Adresler & Fatura Bilgileri</h2>
                            <p class="text-sm text-gray-500">Adres seçimi yalnızca giriş yapan kullanıcılar için görünür. Lütfen giriş yapın.</p>
                        </div>
                    </section>
                }
                
                <!-- Sepet özeti: sadece görseller + adet -->
                <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-black/5">
                    <div class="flex items-center justify-between mb-3">
                        <h2 class="text-lg font-semibold text-gray-900">Sepettekiler</h2>
                        <a href="/Sepet/Index" class="text-sm text-amber-600 hover:text-amber-700 underline">Sepeti görüntüle</a>
                    </div>
                    @if (Model.CartItems != null && Model.CartItems.Any())
                    {
                        <ul class="flex flex-wrap gap-4">
                            @foreach (var item in Model.CartItems)
                            {
                                var src = NormalizeImg(item.ImageUrl);
                                <li class="relative">
                                    <img asp-append-version="true" src="@src" alt="@item.Name" loading="lazy" onerror="this.onerror=null;this.src='/img/temsili.webp';" class="h-16 w-16 rounded-lg object-cover border border-slate-200" />
                                    <span class="absolute -top-2 -right-2 inline-flex items-center justify-center rounded-full bg-amber-500 text-white text-xs font-semibold w-6 h-6">@item.Quantity</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-sm text-slate-600">Sepetiniz boş.</p>
                    }
                </section>
                
                <!-- Kargo Seçimi -->
                <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-black/5 mb-8 ">
                    <h2 class="text-lg font-semibold text-gray-900 mb-3">Kargo Seçimi</h2>
                    <fieldset class="space-y-2">
                        <template x-for="opt in shippingOptions" :key="opt.id">
                            <label class="flex items-center justify-between rounded-lg border border-slate-700 p-3 hover:bg-slate-50">
                                <span class="flex items-center gap-3">
                                    <input type="radio" name="ship" :value="opt.id" x-model="selectedShippingId" class="text-amber-500">
                                    <span class="text-sm text-slate-800" x-text="opt.name"></span>
                                </span>
                                <span class="text-sm font-medium" x-text="isFree ? 'Ücretsiz!' : ('₺' + format(opt.price))"></span>
                            </label>
                        </template>
                    </fieldset>
                </section>

                <!-- Ödeme Yöntemi -->
                <section x-data="payUi(@(User?.Identity?.IsAuthenticated == true ? "true" : "false"))" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-semibold text-slate-900">Ödeme Yöntemi</h2>
                        <div x-show="method==='card'" class="flex items-center space-x-5">
                            <img asp-append-version="true" src="/img/3dsecure.webp"
                                 alt="Pay with iyzico"
                                 class="h-10 w-auto"
                                 loading="lazy" />
                            <img asp-append-version="true" src="/img/go.webp"
                                 alt="Pay with iyzico"
                                 class="h-6 w-auto"
                                 loading="lazy" />

                            <img asp-append-version="true" src="/img/paywithiyzico.webp"
                                 alt="Pay with iyzico"
                                 class="h-10 w-auto"
                                 loading="lazy" />
                        </div>
               
                    </div>

                    <fieldset class="space-y-3">
                        <label class="flex items-center gap-3">
                            <input type="radio" name="pm" value="card" x-model="method" class="text-amber-500">
                            <span class="font-medium text-slate-800">Banka/Kredi Kartı</span>
                        </label>
                        <label class="flex items-center gap-3">
                            <input type="radio" name="pm" value="iban" x-model="method" class="text-amber-500">
                            <span class="font-medium text-slate-800">Havale/EFT (IBAN) (%3 İndirim)</span>
                        </label>
                    </fieldset>

                    <!-- Kart -->
                    <div x-show="method==='card'" x-transition class="mt-5 space-y-4">
                        <template x-if="saved.length">
                            <div class="space-y-2">
                                <div class="flex items-center justify-between">
                                  <p class="text-sm text-slate-700">Kayıtlı Kartlar</p>
                                  <button type="button" x-on:click="refreshSaved" class="text-xs underline text-slate-600">Yenile</button>
                                </div>
                                <template x-for="c in saved" :key="c.id">
                                    <label class="flex items-center justify-between rounded-lg border p-3 hover:bg-slate-50">
                                        <span class="flex items-center gap-3">
                                            <input type="radio" name="cardSel" :value="c.id" x-model="selectedId">
                                            <span class="text-sm text-slate-800" x-text="`${c.brand} •••• ${c.last4}`"></span>
                                        </span>
                                        <span class="text-xs text-slate-500" x-text="c.holder"></span>
                                    </label>
                                </template>
                            </div>
                        </template>

                        <details :open="!saved.length" class="rounded-lg border border-slate-400 p-3 bg-gray-50">
                            <summary class="cursor-pointer text-sm font-medium text-slate-600">Yeni kart ekle</summary>
                            <div class="mt-3 grid gap-3">
                                <input x-model="newCard.name" placeholder="Kart üzerindeki isim" class="rounded-lg border border-slate-400 px-3 py-2">
                                <input x-model="newCard.number" @@input="maskCard" maxlength="23" inputmode="numeric" placeholder="XXXX XXXX XXXX XXXX XXXX" class="rounded-lg border border-slate-400 px-3 py-2">
                                <div class="grid grid-cols-3 gap-3">
                                    <input x-model="newCard.exp" @@input="maskExp" maxlength="5" inputmode="numeric" placeholder="AA/YY" class="rounded-lg border border-slate-400 px-3 py-2">
                                    <input x-model="newCard.cvc" maxlength="4" inputmode="numeric" placeholder="CVC" class="rounded-lg border border-slate-400 px-3 py-2">
                                    <label class="flex items-center gap-2 text-sm">
                                        <input type="checkbox" x-model="newCard.save" :disabled="!isAuth" :title="isAuth ? '' : 'Kart kaydetmek için giriş yapın'" class="rounded border-slate-300"> Kaydet
                                    </label>
                                </div>
                            </div>
                        </details>
                    </div>

                    <!-- Taksit Seçenekleri -->
                    <div x-show="method==='card'" x-transition class="mt-4">
                        <template x-if="installments.length > 0">
                            <div class="rounded-lg border border-slate-200 overflow-hidden">
                                <div class="bg-slate-50 px-4 py-2 border-b border-slate-200">
                                    <h3 class="text-sm font-semibold text-slate-700">Taksit Seçenekleri</h3>
                                    <p class="text-xs text-slate-500" x-text="installmentBank"></p>
                                </div>
                                <div class="divide-y divide-slate-100">
                                    <template x-for="plan in installments" :key="plan.count">
                                        <label class="flex items-center justify-between px-4 py-3 hover:bg-slate-50 cursor-pointer transition-colors"
                                               :class="selectedInstallment === plan.count ? 'bg-amber-50 border-l-2 border-l-amber-400' : ''">
                                            <span class="flex items-center gap-3">
                                                <input type="radio" name="installment"
                                                       :value="plan.count"
                                                       x-model.number="selectedInstallment"
                                                       class="text-amber-500">
                                                <span class="text-sm text-slate-800"
                                                      x-text="plan.count === 1 ? 'Tek Çekim' : (plan.count + ' Taksit')"></span>
                                            </span>
                                            <span class="text-right">
                                                <span class="text-sm font-medium text-slate-900"
                                                      x-text="plan.count === 1 ? ('₺' + format(plan.totalPrice)) : ('₺' + format(plan.installmentPrice) + ' x ' + plan.count)"></span>
                                                <template x-if="plan.count > 1">
                                                    <span class="block text-xs text-slate-500"
                                                          x-text="'Toplam: ₺' + format(plan.totalPrice)"></span>
                                                </template>
                                            </span>
                                        </label>
                                    </template>
                                </div>
                            </div>
                        </template>
                        <p x-show="installmentLoading" class="text-sm text-slate-500 animate-pulse">
                            Taksit seçenekleri yükleniyor...
                        </p>
                    </div>

                    <!-- IBAN -->
                    <div x-show="method==='iban'" x-transition class="mt-5 space-y-3">
                        <p class="text-sm text-slate-700">Aşağıdaki IBAN’a transfer yapın. Açıklamaya sipariş numaranızı yazın.</p>
                        <div class="flex items-center gap-2">
                            <code id="ibanText" class="flex-1 bg-white border border-slate-300 rounded-lg p-3 font-mono text-sm">TR64 0006 7010 0000 0011 7253 73</code>
                            <button type="button" id="copyIban" class="rounded-lg border border-slate-300 px-3 py-2 text-sm hover:bg-slate-50">Kopyala</button>
                            <code id="ibanText" class="flex-1 bg-white border border-slate-300 rounded-lg p-3 font-mono text-sm mb-5">MEHMET YİĞİT DAYI</code>
                        </div>
                        <p class="text-xs text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg p-2">IBAN ile ödeme seçtiğinizde toplam tutara %3 indirim uygulanır.</p>
                    </div>

                    <div x-show="method==='card'" class="mt-6 flex items-center gap-2">
                        <input type="checkbox" x-model="newCard.threeD" class="rounded border-slate-300">
                        <label class="text-xs text-slate-600">
                            3D Secure ile öde
                        </label>
                    </div>
                    <div class="mt-6 flex items-center gap-2">
                        <input id="sozlesme" type="checkbox" class="rounded border-slate-300">
                        <label for="sozlesme" class="text-xs text-slate-600">
                            Ön bilgilendirme formu ve
         <button
  x-on:click.prevent="$store.contract.openModal()"
          class="text-amber-600 hover:text-amber-700 underline font-medium cursor-pointer">
               Mesafeli satış sözleşmesini okudum, onaylıyorum
        </button>.
                </label>
    </div>

                    <template x-if="notice">
                        <div class="mt-4 rounded-lg border p-3" :class="notice.success ? 'border-emerald-200 bg-emerald-50 text-emerald-700' : 'border-red-200 bg-red-50 text-red-700'">
                            <p class="text-sm font-medium" x-text="notice.message"></p>
                        </div>
                    </template>

                    <button type="button"
                            x-on:click="placeOrder"
                            :disabled="loading"
                            class="mt-4 w-full h-12 rounded-xl bg-amber-300 font-semibold text-gray-900 hover:bg-amber-400 disabled:opacity-60 flex items-center justify-center gap-2">
                        <svg x-show="loading" class="animate-spin w-6 h-6 text-yellow-800" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-75 text-yellow-600" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z" />
                        </svg>
                        <span x-text="loading ? 'İşleniyor...' : (method==='iban' ? 'Siparişi tamamla (IBAN - %3 indirim)' : 'Siparişi onayla')"></span>
                    </button>
                </section>
            </div>

            <!-- Sağ sütun -->
            <aside class="lg:col-span-1">
                <div class="lg:sticky lg:top-24 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <h3 class="text-base font-semibold text-slate-900 mb-4">Sipariş Özeti</h3>
                    <dl class="space-y-2 text-sm">
                        <div class="flex justify-between">
                            <dt class="text-slate-600">Ara Toplam</dt>
                            <dd class="text-slate-900 font-medium"><span x-text="'₺' + format(subTotal)"></span></dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-slate-600">Kargo</dt>
                            <dd class="text-slate-900 font-medium">
                                <span x-text="isFree ? 'Ücretsiz!' : ('₺' + format(shipping))"></span>
                            </dd>
                        </div>
                        <div class="flex justify-between">
                            <dt class="text-slate-600">KDV (dahil)</dt>
                            <dd class="text-slate-900 font-medium"><span x-text="'₺' + format(vatAmount)"></span></dd>
                        </div>
                        <div class="h-px bg-slate-200 my-2"></div>
                        <div class="flex justify-between text-base">
                            <dt class="text-slate-900 font-semibold">Genel Toplam</dt>
                            <dd class="text-slate-900 font-semibold">
                                <span x-text="'₺' + format(grand)"></span>
                            </dd>
                        </div>
                        <template x-if="method==='iban'">
                            <div class="flex justify-between text-xs text-emerald-700 mt-1">
                                <dt>%3 IBAN indirimi sonrası ödenecek</dt>
                                <dd><span x-text="'₺' + format(round(grand * 0.97))"></span></dd>
                            </div>
                        </template>
                    </dl>
                    <p class="text-xs text-slate-500 mt-4">Adres ve ödeme bilgilerinizi doğrulamadan sipariş oluşturulmaz.</p>
                </div>
            </aside>
        </div>
    </div>
</main>
@await Html.PartialAsync("_MesafeliSatisPartial", Model.Contract)
@if (User?.Identity?.IsAuthenticated == true)
{
    @await Html.PartialAsync("_AddressModalPartial")
}

<script>
    // Extend the Alpine store to pass dynamic shipping data
    document.addEventListener('alpine:init', () => {
   const originalOpenModal = Alpine.store('contract')?.openModal;
        if (originalOpenModal) {
      Alpine.store('contract').openModal = function() {
   // Get current shipping price from checkout state
                const state = window.checkoutState || null;
  const currentShipping = state ? state.shipping : 0;
    
   // Store the current shipping for the contract modal to use
     this.currentShipping = currentShipping;
    
       // Call the original openModal
 originalOpenModal.call(this);
       };
        }
    });
    
  function checkout(subTotal, vat, threshold){
      return {
        // inputs
        subTotal: Number(subTotal || 0),
        vat: Number(vat || 0.20),
        freeShipThreshold: Number(threshold || 2500),

      // shipping catalog
        shippingOptions: [
          { id:'aras',     name:'Aras Kargo',    price:159.90 },
      { id:'hepsijet', name:'HepsiJET',      price:129.90 },
        { id:'yurtici',  name:'Yurtiçi Kargo', price:199.61 }
     ],
        selectedShippingId: 'hepsijet',
        // payment method lives here (not in payUi) so the order summary aside can read it too
        method: 'card',
    
        // lifecycle
        init(){
          try { window.checkoutState = this; } catch {}
   },

        // derived
        get isFree(){ return this.subTotal >= this.freeShipThreshold; },
      get selectedShipping(){ return this.shippingOptions.find(o => o.id === this.selectedShippingId) || null; },
     get shipping(){ return this.isFree ? 0 : (this.selectedShipping ? this.selectedShipping.price : 0); },
        get vatAmount(){ return this.round((this.subTotal + this.shipping) * this.vat); },
     get grand(){ return this.round(this.subTotal + this.shipping); },

        // helpers
        format(n){ return new Intl.NumberFormat('tr-TR', {minimumFractionDigits:2, maximumFractionDigits:2}).format(Number(n||0)); },
      round(n){ return Math.round(Number(n||0) * 100) / 100; },

        // keep contract param accurate
        contractWithShipping(href){
          try{
          const u = new URL(href, window.location.origin);
       u.searchParams.set('shipping', this.shipping.toFixed(2));
        return u.toString();
          }catch{ return href; }
        }
      }
 }

    // IBAN copy
    (function () {
      const btn = document.getElementById('copyIban');
      const node = document.getElementById('ibanText');
      if (!btn || !node) return;
      btn.addEventListener('click', async () => {
        const text = node.innerText.replace(/\s+/g, ' ').trim();
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Kopyalandı';
          setTimeout(() => btn.textContent = 'Kopyala', 1500);
        } catch {}
      });
    })();

    // Payment UI
    function payUi(isAuth){
      return {
        isAuth: Boolean(isAuth),
        saved:[],
        selectedId:null,
        newCard:{name:'', number:'', exp:'', cvc:'', save:true, threeD:false},
        loading:false,
        notice:null,
        digits(s){ return (s||'').replace(/\D/g,''); },
        // allow up to 19 digits and group by 4
        maskCard(){ let d=this.digits(this.newCard.number).slice(0,19); this.newCard.number=d.replace(/(\d{4})(?=\d)/g,'$1 ').trim(); if(d.length>=6) this.fetchInstallments(); },
        maskExp(){ let d=this.digits(this.newCard.exp).slice(0,4); this.newCard.exp=(d.length>=3)? d.slice(0,2)+'/'+d.slice(2) : d; },
        luhn(num){ let d=this.digits(num), s=0, alt=false; for(let i=d.length-1;i>=0;i--){ let n=+d[i]; if(alt){ n*=2; if(n>9)n-=9; } s+=n; alt=!alt; } return d.length>=13 && d.length<=19 && s%10===0; },
        async refreshSaved(){
          try{
            const res = await fetch('/Siparis/SavedCards');
            if(!res.ok) return;
            this.saved = await res.json();
          }catch{}
        },
        init(){
          // Preload saved cards (no-op for guests)
          this.refreshSaved();
        },
        // Installment state
        installments: [],
        installmentBank: '',
        installmentLoading: false,
        selectedInstallment: 1,
        lastBinQueried: '',
        async fetchInstallments() {
            const digits = this.digits(this.newCard.number);
            const bin = digits.slice(0, 6);
            if (bin.length < 6 || bin === this.lastBinQueried) return;
            this.lastBinQueried = bin;
            this.installmentLoading = true;
            try {
                const res = await fetch(`/Siparis/Installments?binNumber=${bin}`);
                const data = await res.json();
                if (data.success && data.details?.length > 0) {
                    const detail = data.details[0];
                    this.installmentBank = `${detail.bankName || ''} ${detail.cardFamily || ''}`.trim();
                    this.installments = detail.plans || [];
                    this.selectedInstallment = 1;
                } else {
                    this.installments = [];
                    this.installmentBank = '';
                }
            } catch { this.installments = []; this.installmentBank = ''; }
            finally { this.installmentLoading = false; }
        },
        async placeOrder(){
          if(this.loading) return;
          this.notice = null;
          if(!document.getElementById('sozlesme').checked){
            this.notice = { success:false, message:'Lütfen sözleşmeyi onaylayın.' };
            return;
          }
          const state = window.checkoutState || null;
          const payloadBase = {
            shippingPrice: state ? state.shipping : 0,
            shippingId: state ? state.selectedShippingId : null
          };
          if(this.method==='card'){
            if(this.selectedId){
              // Respect 3D Secure checkbox for saved cards too
              await this.send({ paymentMethod:'card_saved', cardId:this.selectedId, threeDSecure: this.newCard.threeD === true, installment: this.selectedInstallment, ...payloadBase });
              return;
            }
            if(!this.luhn(this.newCard.number)){
              this.notice = { success:false, message:'Kart numarası geçersiz görünüyor.' };
              return;
            }
            await this.send({
              paymentMethod:'card_new',
              name:this.newCard.name,
              number:this.digits(this.newCard.number),
              exp:this.newCard.exp,
              cvc:this.newCard.cvc,
              save:this.newCard.save,
              threeDSecure:this.newCard.threeD === true,
              installment:this.selectedInstallment,
              ...payloadBase
            });
          } else if(this.method==='iban'){
            await this.send({ paymentMethod:'iban', ...payloadBase });
          }
        },
        async send(payload){
          const tokenEl = document.querySelector('meta[name="request-verification-token"]');
          const headers = { 'Content-Type':'application/x-www-form-urlencoded' };
          if(tokenEl){ headers['RequestVerificationToken'] = tokenEl.content; }
          const body = new URLSearchParams();
          Object.entries(payload).forEach(([key,value]) => {
            if(Array.isArray(value)) return;
            body.append(key, value ?? '');
          });
          this.loading = true;
          try {
            const response = await fetch('/Siparis/PlaceOrder', {
              method:'POST',
              headers,
              body
            });
            let data = null;
            try {
              data = await response.json();
            } catch {}
            if(!response.ok || !data || !data.success){
              const message = data?.message || `Ödeme sırasında bir sorun oluştu. Lütfen tekrar deneyin. (HTTP ${response.status})`;
              this.notice = { success:false, message };
              return;
            }
            // success: show order key immediately
            this.notice = { success:true, message: data.message || 'Ödemeniz başarıyla tamamlandı.' };
            // if card was saved, refresh saved list for immediate feedback
            if(payload.paymentMethod === 'card_new' && String(payload.save) === 'true'){
              this.refreshSaved();
            }
            if(data.redirectUrl){
              window.location.href = data.redirectUrl;
            } else {
              setTimeout(() => window.location.href = '/', 3000);
            }
          } catch (err){
            this.notice = { success:false, message:'Beklenmeyen bir hata oluştu. Lütfen tekrar deneyin.' };
          } finally {
            this.loading = false;
          }
        }
      }
    }
</script>

