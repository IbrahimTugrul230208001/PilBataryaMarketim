# =========================
# Supplier stock sync
# =========================
StockSync__Enabled=true
# Run times in Turkey time. Leave unset for the default: every 4 hours (00:00, 04:00 ... 20:00).
# To override, list them all: StockSync__RunTimesLocal__0=06:00, StockSync__RunTimesLocal__1=18:00 ...
# One URL per supplier code (Suppliers.Code); keep the access key here, never in the database
StockSync__Feeds__pilmagazasi__Url=
